  "responseMessages": [
    {
      "id": "677e8375793d3400072fd520",
      "discriminatorID": "677e8375793d3400072fd51f",
      "text": [
        {
          "text": [
            "Welcome to Fasterise💪 What can I help You with?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd523",
      "discriminatorID": "677e8375793d3400072fd522",
      "text": [
        {
          "text": [
            "I can assist you in finding the perfect solutions for your case"
          ]
        },
        {
          "text": [
            {
              "text": [
                ""
              ]
            }
          ]
        },
        {
          "text": [
            "Let’s get started! I'll ask a few questions to understand your goals and preferences."
          ]
        },
        {
          "text": [
            {
              "text": [
                ""
              ]
            }
          ]
        },
        {
          "text": [
            "Don’t worry, your information will be kept confidential and will only be used to provide you with the best recommendations."
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd526",
      "discriminatorID": "677e8375793d3400072fd525",
      "text": [
        {
          "text": [
            "First, can I start off with your name?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd529",
      "discriminatorID": "677e8375793d3400072fd528",
      "text": [
        {
          "text": [
            "Thanks ",
            {
              "variableID": "first_name"
            },
            " !"
          ]
        },
        {
          "text": [
            {
              "text": [
                ""
              ]
            }
          ]
        },
        {
          "text": [
            "In order for us to send you recommendations based on your needs, can we please have your email?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd52c",
      "discriminatorID": "677e8375793d3400072fd52b",
      "text": [
        {
          "text": [
            "Oops, looks like something went wrong. Please try again."
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd52f",
      "discriminatorID": "677e8375793d3400072fd52e",
      "text": [
        {
          "text": [
            "Thanks for finishing the questionnaire. Based on your answers we have a few recommendations you might be interested in."
          ]
        },
        {
          "text": [
            {
              "text": [
                ""
              ]
            }
          ]
        },
        {
          "text": [
            "We'll email you a copy of the recommendations so you can review them again/later."
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd532",
      "discriminatorID": "677e8375793d3400072fd531",
      "text": [
        {
          "text": [
            "Great! Let's get started with a few questions to figure out your goals."
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd535",
      "discriminatorID": "677e8375793d3400072fd534",
      "text": [
        {
          "text": [
            "What value can we bring to your company?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd538",
      "discriminatorID": "677e8375793d3400072fd537",
      "text": [
        {
          "text": [
            "Would you like to request a call for one of our experts to follow up with you?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd53b",
      "discriminatorID": "677e8375793d3400072fd53a",
      "text": [
        {
          "text": [
            "No problem! Our contact information will be in the follow up email."
          ]
        },
        {
          "text": [
            {
              "text": [
                ""
              ]
            }
          ]
        },
        {
          "text": [
            "Feel free to contact us if/when you'd like to schedule a consultation."
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd53e",
      "discriminatorID": "677e8375793d3400072fd53d",
      "text": [
        {
          "text": [
            "What date works best for you?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd541",
      "discriminatorID": "677e8375793d3400072fd540",
      "text": [
        {
          "text": [
            "What's the best time?"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd544",
      "discriminatorID": "677e8375793d3400072fd543",
      "text": [
        {
          "text": [
            "Awesome. We've noted your goals, interests, and call request time. "
          ]
        },
        {
          "text": [
            {
              "text": [
                ""
              ]
            }
          ]
        },
        {
          "text": [
            "We'll have our expert reach out to you at the requested time."
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd547",
      "discriminatorID": "677e8375793d3400072fd546",
      "text": [
        {
          "text": [
            "Thank you so much for your time today. Have a wonderful day! 😊"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
    {
      "id": "677e8375793d3400072fd54a",
      "discriminatorID": "677e8375793d3400072fd549",
      "text": [
        {
          "text": [
            "heyyy"
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2025-01-08T13:53:57.000Z"
    },
